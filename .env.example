# Server & Database
PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/delay_monitor
HTTPS_PROXY=

# Upstream WebSocket & Auth
LOGIN_URL=https://nextfleet-vision.ioh.co.id/vss/user/apiLogin.action
LOGIN_USERNAME=your_username
LOGIN_PASSWORD=your_password
LOGIN_LANG=0
LOGIN_CLIENT=2
WS_SOURCE_URL=wss://nextfleet-vision.ioh.co.id:36301/wss

# Ingestion & Health Thresholds (ms)
WS_ACTIVITY_TIMEOUT_MS=45000
WS_DATA_SILENCE_RECONNECT_MS=0
HEALTH_DATA_STALE_MS=120000

# Data Retention (days)
HISTORY_RETENTION_DAYS=7
ROLLUP_RETENTION_DAYS=90

# Daily Summary Email Scheduler
EMAIL_ENABLED=false
EMAIL_TEST_MODE=true
EMAIL_SEND_HOUR=10
EMAIL_SEND_MINUTE=0

# SMTP Configuration
SMTP_HOST=smtpgw2.ioh.co.id
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=b2bops_alert_noreply@ioh.co.id
EMAIL_TEST_TO=tester@ioh.co.id
EMAIL_TEST_CC=
EMAIL_TO=recipient1@ioh.co.id,recipient2@ioh.co.id
EMAIL_CC=
DASHBOARD_URL=http://localhost:3000
